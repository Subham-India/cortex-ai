PORT=8000

# Gateway
AUTH_SERVICE_URL=http://auth:8001
CHAT_SERVICE_URL=http://chat:8002

# Auth service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cortex
REDIS_URL=redis://redis:6379
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# Chat service
AGENT_SERVICE_URL=http://agent:8003

# Agent service
RAG_SERVICE_URL=http://rag:8004
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
HF_TOKEN=your_hf_token
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# RAG service
SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Frontend
VITE_RAG_SERVICE_URL=http://rag:8004
VITE_AGENT_SERVICE_URL=http://agent:8003
VITE_API_BASE_URL=http://gateway:8000
